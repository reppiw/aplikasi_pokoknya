rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Username reservation & lookup
    match /usernames/{username} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // User profiles — readable by all authenticated users (to view friends/office peers),
    // writable only by the profile owner.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Group metadata
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      // Real-time avatar presence in group offices
      match /avatars/{userId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null
          && request.auth.uid == userId;
      }

      // Dynamic rooms & furniture layouts
      match /rooms/{roomId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    // 1-on-1 Chat rooms & messages
    match /chat_rooms/{chatRoomId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && (!exists(/databases/$(database)/documents/chat_rooms/$(chatRoomId))
              || request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(chatRoomId)).data.participants);
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid;
      }
    }

    // Targeted room pings
    match /room_pings/{pingId} {
      allow read, create: if request.auth != null;
    }
  }
}
